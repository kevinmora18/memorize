# ═══════════════════════════════════════════════════════════════
# EJEMPLO DE CONFIGURACIÓN - Memorize
# ═══════════════════════════════════════════════════════════════
# 
# INSTRUCCIONES:
# 1. Copia este archivo como ".env" en la raíz del proyecto
# 2. Reemplaza los valores de ejemplo con tus datos reales
# 3. NO subas el archivo .env al repositorio (está en .gitignore)
#

# ── Base de Datos ───────────────────────────────────────────────
# Contraseña para PostgreSQL en Docker
POSTGRES_PASSWORD=tu_password_super_seguro_aqui

# ── Notas de Configuración ──────────────────────────────────────
# 
# Frontend (.env en frontend/):
#   - En desarrollo: VITE_API_BASE=http://localhost:5175
#   - En producción: VITE_API_BASE="" (Nginx maneja el proxy)
#
# Backend (.env en backend/):
#   - DATABASE_URL se genera automáticamente en Docker
#   - PORT=3000 en producción (Docker)
#   - PORT=5175 en desarrollo local
#   - FRONTEND_URL=* permite todas las conexiones
#
